# Copy to .env (never commit .env). All optional for local play.
TB_ADMIN_KEY=change-me-to-a-long-random-string   # needed to release results / view the leaderboard
TB_TIME_SCALE=1.0                                 # 1.0 = real 70-minute event; 0.1 = 7-minute demo
TB_DB_PATH=tech_blitz.db                          # SQLite file
